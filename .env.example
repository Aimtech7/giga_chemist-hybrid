# =============================================================================
# GIGA CHEMIST — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and fill in your environment-specific credentials:
#   copy .env.example .env
#
# DO NOT commit real secrets or passwords to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME
# -----------------------------------------------------------------------------
APP_MODE=local

API_HOST=0.0.0.0
API_PORT=3000
PORT=3000

# Frontend API URL (leave empty for same-origin relative '/api' on single-server or PWA)
VITE_API_URL=

# Backend Secret for HMAC-SHA256 JWT Authentication tokens (Never expose to frontend)
# REQUIRED: at least 32 random characters. The server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=YOUR_JWT_SECRET_KEY

# -----------------------------------------------------------------------------
# 2. LOCAL POSTGRESQL (Target Windows 11 PC)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=giga_chemist
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_SSL=false

# Canonical local database connection URLs
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/giga_chemist
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/giga_chemist

# -----------------------------------------------------------------------------
# 3. HYBRID CLOUD SYNC (server side only — see docs/GIGA_CHEMIST_HYBRID_ARCHITECTURE.md)
# -----------------------------------------------------------------------------
# APP_MODE=local   PostgreSQL only, no cloud at all.
# APP_MODE=hybrid  PostgreSQL stays authoritative; every business write also records a durable
#                  outbox event in the same transaction. SYNC_ENABLED=true starts the background
#                  worker that delivers those events to the cloud (and pulls cloud commands).
# Checkout NEVER waits for the cloud; the POS works fully offline in both modes.
SYNC_ENABLED=false

# Supabase project (https only). These are read by the LOCAL SERVER and never sent to the browser.
SUPABASE_URL=https://your-project-id.supabase.co
# Gateway key for the REST endpoint. The anon key is enough: every sync RPC additionally checks
# the shop token below. Use the service role key only if your project requires it (backend only).
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=
# Per-shop secret registered in the cloud with giga_cloud.register_shop(...). >= 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SYNC_SHOP_TOKEN=YOUR_SHOP_SYNC_TOKEN

# Shop identity is generated once in PostgreSQL (table shop_identity) and survives restarts.
# Leave SHOP_ID empty to use it; set it only to adopt a cloud-assigned id BEFORE the first sync.
SHOP_ID=

# Worker tuning (defaults shown)
SYNC_INTERVAL_SECONDS=30
SYNC_BATCH_SIZE=50
SYNC_HTTP_TIMEOUT_MS=10000
SYNC_MAX_BACKOFF_SECONDS=120

# Browser-side Supabase keys are NOT needed for hybrid sync (the browser never talks to the cloud).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# 4. DEVICE
# -----------------------------------------------------------------------------
# Identifier of this server/terminal, reported in sync status (not the shop identity).
DEVICE_ID=POS-TERMINAL-01

# -----------------------------------------------------------------------------
# 5. NETWORK (LAN)
# -----------------------------------------------------------------------------
# 0.0.0.0 = reachable by POS terminals on the shop LAN (allow port 3000 in Windows Firewall for the
# Private profile / LAN subnet ONLY). 127.0.0.1 = this PC only. Never port-forward 3000 or 5432.
# API_HOST=0.0.0.0
# Comma-separated origins allowed to call the API from another site (e.g. an online frontend).
# Empty = previous permissive behaviour. POS terminals are same-origin and need nothing here.
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# 6. EMAIL REPORTS (server only — never VITE_*)
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=GIGA CHEMIST <reports@your-domain.example>
STOCK_REPORT_RECIPIENTS=owner@your-domain.example
STOCK_REPORT_TIME=18:00
BUSINESS_REPORT_TIME=18:05
EMAIL_TIMEZONE=Africa/Nairobi
# Optional tuning: EMAIL_WORKER_INTERVAL_SECONDS=30 EMAIL_RETRY_BASE_SECONDS=60
#                  EMAIL_MAX_BACKOFF_SECONDS=1800 EMAIL_MAX_ATTEMPTS=50 SMTP_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# 7. AUTOMATED BACKUPS (pg_dump; never restores)
# -----------------------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_TIME=21:00
BACKUP_DIR=backups
BACKUP_KEEP=14
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
