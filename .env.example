# =============================================================================
# GIGA CHEMIST — SHOP 2 ENVIRONMENT TEMPLATE (.env.example)
# SAFE PLACEHOLDERS ONLY — DO NOT INSERT SECRETS OR SHOP 1 VALUES
# =============================================================================

# Application Mode: local (offline development)
APP_MODE=local
SYNC_ENABLED=false
PORT=5002

# Local Operational PostgreSQL Database (Shop 2)
# Development: giga_chemist_shop2_dev | Production: giga_chemist_shop2
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=giga_chemist_shop2_dev
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/giga_chemist_shop2_dev

# Shop 2 Cloud Sync Configuration (Leave BLANK during development)
# WARNING: NEVER USE SHOP 1 ID (c2a176c8-a50f-456f-a370-225c11d2e32f)
SHOP_ID=
SHOP_TOKEN=
SYNC_SHOP_TOKEN=

# Cloud Mirror (Leave BLANK during development)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local JWT Secret
JWT_SECRET=
