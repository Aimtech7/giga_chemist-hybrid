# =============================================================================
# GIGA CHEMIST — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and fill in your environment-specific credentials:
#   copy .env.example .env
#
# DO NOT commit real secrets or passwords to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME
# -----------------------------------------------------------------------------
APP_MODE=local

API_HOST=0.0.0.0
API_PORT=3000
PORT=3000

# Frontend API URL (leave empty for same-origin relative '/api' on single-server or PWA)
VITE_API_URL=

# Backend Secret for HMAC-SHA256 JWT Authentication tokens (Never expose to frontend)
# REQUIRED: at least 32 random characters. The server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=YOUR_JWT_SECRET_KEY

# -----------------------------------------------------------------------------
# 2. LOCAL POSTGRESQL (Target Windows 11 PC)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=giga_chemist
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_SSL=false

# Canonical local database connection URLs
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/giga_chemist
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/giga_chemist

# -----------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Optional / Hybrid Cloud Sync)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# 4. OFFLINE SYNC & DEVICE CONFIGURATION
# -----------------------------------------------------------------------------
SYNC_ENABLED=false
DEVICE_ID=POS-TERMINAL-01
SYNC_INTERVAL_SECONDS=30