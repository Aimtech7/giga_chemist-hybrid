# ============================================================
# GIGA CHEMIST ONLINE / VERCEL ENVIRONMENT — TEMPLATE (placeholders only)
# ============================================================
# Copy to .env.online (git-ignored) and fill in. Validate: npm run env:check:online
# VITE_* values are PUBLIC (compiled into the browser bundle): never put secrets in them.
# Vercel = frontend (dist/) + the online API function (api/index.js) on the same origin.
# [SERVER] values go into Vercel project settings (server-side only); VITE_* are public.

# APPLICATION MODE [SERVER]
APP_MODE=online
SYNC_ENABLED=false
NODE_ENV=production

# FRONTEND / VITE [PUBLIC]
VITE_APP_MODE=online
VITE_SYNC_ENABLED=true
# Blank = same origin (/api on the Vercel domain). Optional override only.
VITE_API_URL=
# Not needed (the browser never talks to Supabase). Leave unset on Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SUPABASE SERVER [SERVER]
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Optional (sync uses anon key + per-shop token). Server only — never VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# AUTHENTICATION [SERVER]
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=YOUR_LONG_RANDOM_SERVER_SECRET

# DATABASE / CLOUD [SERVER] — cloud PostgreSQL only, never localhost
# Supabase -> Connect -> Transaction pooler (IPv4; the direct db.<ref>.supabase.co host is IPv6-only)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# SHOP IDENTITY (from the shop database: npm run db:check)
SHOP_ID=YOUR_SHOP_UUID
BRANCH_ID=YOUR_BRANCH_UUID

# SYNC [SERVER]
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_SECONDS=30
SYNC_INTERVAL_MS=30000
SYNC_MAX_ATTEMPTS=10

# CORS / PUBLIC URL
APP_URL=https://gigachem.vercel.app
PUBLIC_APP_URL=https://gigachem.vercel.app
ALLOWED_ORIGINS=https://gigachem.vercel.app

# EMAIL REPORTS [SERVER ONLY — never VITE_*]
EMAIL_ENABLED=false
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=GIGA CHEMIST <reports@your-domain.example>
STOCK_REPORT_RECIPIENTS=owner@your-domain.example
STOCK_REPORT_TIME=18:00
BUSINESS_REPORT_TIME=18:05
EMAIL_TIMEZONE=Africa/Nairobi
