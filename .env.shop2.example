# =============================================================================
# GIGA CHEMIST — SHOP 2 ENVIRONMENT SPECIFICATION (.env.shop2.example)
# =============================================================================
#
# RULE 1: DEVELOPMENT IS LOCAL ONLY
#   During development in B:\GIGA-CHEMIST-POS-2:
#     - APP_MODE=local
#     - SYNC_ENABLED=false
#     - DB_NAME=giga_chemist_shop2_dev
#     - SHOP_ID and SYNC_SHOP_TOKEN MUST remain empty.
#     - The development PC must NEVER impersonate or sync as Shop 2.
#
# RULE 2: PRODUCTION SHOP 2 REQUIRES A UNIQUE IDENTITY
#   When deploying to the actual Shop 2 computer:
#     - A brand-new, unique SHOP_ID UUID will be generated and registered in Supabase.
#     - A brand-new, unique SHOP_TOKEN will be generated.
#     - DB_NAME=giga_chemist_shop2
#     - NEVER copy Shop 1 ID (c2a176c8-a50f-456f-a370-225c11d2e32f).
#     - NEVER copy Shop 1 sync tokens or database state.
#
# =============================================================================

# --- DEVELOPMENT SETTINGS (LOCAL ONLY) ---
APP_MODE=local
SYNC_ENABLED=false
PORT=5002

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=giga_chemist_shop2_dev
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/giga_chemist_shop2_dev

# --- FUTURE PRODUCTION CLOUD SETTINGS (POPULATED ONLY ON LIVE SHOP 2 COMPUTER) ---
# SHOP_ID=<unique-shop2-uuid-generated-at-activation>
# SYNC_SHOP_TOKEN=<unique-shop2-secret-generated-at-activation>
# SUPABASE_URL=https://vvdgrmvmdwlyesffwefs.supabase.co
# SUPABASE_ANON_KEY=<project-anon-key>
